{
  "version": 2,
  "cleanUrls": true,
  "redirects": [
    {"source": "/leads", "destination": "https://leads.ronnascanner.com", "permanent": true},
    {"source": "/contacts", "destination": "https://contacts.ronnascanner.com", "permanent": true},
    {"source": "/emails", "destination": "https://emails.ronnascanner.com", "permanent": true},
    {"source": "/companies", "destination": "https://companies.ronnascanner.com", "permanent": true},
    {"source": "/prospects", "destination": "https://prospects.ronnascanner.com", "permanent": true}
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {"key": "X-Content-Type-Options", "value": "nosniff"},
        {"key": "X-Frame-Options", "value": "DENY"},
        {"key": "X-XSS-Protection", "value": "1; mode=block"},
        {"key": "Referrer-Policy", "value": "strict-origin-when-cross-origin"},
        {"key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), payment=(self)"},
        {"key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains; preload"}
      ]
    }
  ]
}
